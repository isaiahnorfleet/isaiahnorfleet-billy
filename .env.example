# Copy to .env.local for local development. Placeholders only: never commit real values.
# In production, set these in Vercel > Project > Settings > Environment Variables.

# Public URL of the app (used in notification links and emails)
APP_URL=http://localhost:3000

# Postgres connection used by the server only (Supabase: Project Settings > Database > Connection string,
# "Transaction pooler", port 6543). Contains the database password: server-side only.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/billy_dev

# Auth: "supabase" in every deployed environment. "dev" enables a local-only sign-in for development and tests.
AUTH_MODE=supabase
# Required only when AUTH_MODE=dev (32+ random characters). Refused when VERCEL_ENV=production.
DEV_AUTH_SECRET=

# Supabase (Project Settings > API). The publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Email (Resend). EMAIL_FROM must use a verified domain, or onboarding@resend.dev for your own address only.
RESEND_API_KEY=
EMAIL_FROM="Billy <onboarding@resend.dev>"

# Shared secret the scheduler sends as "Authorization: Bearer <CRON_SECRET>" (32+ random characters)
CRON_SECRET=

# "fake" swaps push/email for in-memory fakes. Local/test only; refused in production.
NOTIFY_PROVIDER=real
