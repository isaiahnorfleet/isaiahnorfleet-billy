{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "norfleet:common.envelope@1",
  "title": "Norfleet Connect response envelope, v1",
  "type": "object",
  "required": ["contract", "version", "provider", "generated_at", "page", "data", "completeness"],
  "properties": {
    "contract": { "type": "string", "pattern": "^[a-z]+\\.[a-z-]+$" },
    "version": { "type": "string", "pattern": "^1\\.\\d+\\.\\d+$" },
    "provider": {
      "type": "object",
      "required": ["app", "build"],
      "properties": {
        "app": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$" },
        "build": { "type": "string", "maxLength": 64 },
        "business_ref": { "type": "string", "maxLength": 32 }
      }
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "page": {
      "type": "object",
      "required": ["cursor", "next_cursor", "limit"],
      "properties": {
        "cursor": { "type": ["string", "null"], "maxLength": 500 },
        "next_cursor": { "type": ["string", "null"], "maxLength": 500 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 500 }
      }
    },
    "data": { "type": "array" },
    "completeness": {
      "type": "object",
      "required": ["status", "notes"],
      "properties": {
        "status": { "enum": ["complete", "partial", "unknown"] },
        "notes": { "type": "array", "items": { "type": "string", "maxLength": 200 } }
      }
    }
  }
}
